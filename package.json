{
  "name": "x402-refund-hold",
  "version": "0.1.0",
  "description": "The $0.01 refundable-hold pattern as drop-in Express middleware — charge a hold, auto-refund on failure, ledger included",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nirholas/x402-refund-hold"
  },
  "homepage": "https://nirholas.github.io/x402-refund-hold/",
  "keywords": [
    "x402",
    "micropayments",
    "usdc",
    "solana",
    "base",
    "ai-agents",
    "agentic-commerce",
    "refunds",
    "refundable-hold",
    "express-middleware",
    "ledger"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skill.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "client": "tsx examples/agent-client.ts"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@three-ws/x402-payment-modal": "^1.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "viem": "^2.21.0",
    "x402": "^1.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "x402-fetch": "^1.2.0",
    "bigint-buffer": "file:vendor/bigint-buffer"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "nirholas <nichxbt@gmail.com>",
  "overrides": {
    "decode-uri-component@<=0.5.0": "^0.5.1",
    "decode-uri-component@<=0.4.2": "^0.5.1",
    "zod@<4.6.6": "^4.6.6",
    "stream-json@<=3.5.0": "^3.6.0",
    "stream-json@<3.6.0": "^3.6.0",
    "stream-json@<=3.4.0": "^3.6.0",
    "ws@>=8.0.0 <8.21.0": "^8.21.0",
    "ws@>=8.0.0 <8.20.1": "^8.21.0",
    "uuid@<11.1.1": "^11.1.1",
    "bigint-buffer": "$bigint-buffer"
  }
}
